{
  "name": "page-markdown",
  "version": "0.1.4",
  "description": "Faithful page-to-Markdown for humans and agents: sanitize, extract the readable article, convert with GFM, and clean without losing content.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "LICENSE",
    "ADDITIONAL_TERMS.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "robots.txt"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "size": "node bench/size.mjs",
    "ci": "npm test && npm run size",
    "bench": "node bench/compare.mjs"
  },
  "keywords": [
    "markdown",
    "readability",
    "html-to-markdown",
    "reader-mode",
    "web-clipper",
    "browser-extension"
  ],
  "author": "WATT3D <WATT3D@protonmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWhatty/page-markdown.git"
  },
  "homepage": "https://github.com/iWhatty/page-markdown#readme",
  "bugs": {
    "url": "https://github.com/iWhatty/page-markdown/issues"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "text-sanctifier": "1.3.8",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "linkedom": "0.18.12"
  }
}
